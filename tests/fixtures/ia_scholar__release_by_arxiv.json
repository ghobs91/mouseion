{"provider": "ia_scholar", "capability": "release_by_arxiv", "recorded_at": "2026-11-04T22:43:03+00:00", "params": {"arxiv": "1706.03762v5"}, "expected_records": 1, "body": {"work_id": "ceeba05a-4840-4e0a-8454-9b52b577eab2", "container_id": null, "extids": [{"release_id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "id_type": "arxiv", "id_value": "1706.03762v5"}], "contribs": [{"release_id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "creator_id": null, "raw_name": "Ashish Vaswani", "given_name": null, "surname": null, "role": "author", "raw_affiliation": null, "position": 0, "extra": null}, {"release_id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "creator_id": null, "raw_name": "Noam Shazeer", "given_name": null, "surname": null, "role": "author", "raw_affiliation": null, "position": 1, "extra": null}, {"release_id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "creator_id": null, "raw_name": "Niki Parmar", "given_name": null, "surname": null, "role": "author", "raw_affiliation": null, "position": 2, "extra": null}, {"release_id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "creator_id": null, "raw_name": "Jakob Uszkoreit", "given_name": null, "surname": null, "role": "author", "raw_affiliation": null, "position": 3, "extra": null}, {"release_id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "creator_id": null, "raw_name": "Llion\n  Jones", "given_name": null, "surname": null, "role": "author", "raw_affiliation": null, "position": 4, "extra": null}, {"release_id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "creator_id": null, "raw_name": "Aidan N. Gomez", "given_name": null, "surname": null, "role": "author", "raw_affiliation": null, "position": 5, "extra": null}, {"release_id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "creator_id": null, "raw_name": "Lukasz Kaiser", "given_name": null, "surname": null, "role": "author", "raw_affiliation": null, "position": 6, "extra": null}, {"release_id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "creator_id": null, "raw_name": "Illia Polosukhin", "given_name": null, "surname": null, "role": "author", "raw_affiliation": null, "position": 7, "extra": null}], "abstracts": [{"release_id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "sha1": "cff07f38a81b4a48dfde8f41ee8b066d886eb83d", "content": "The dominant sequence transduction models are based on complex recurrent or\nconvolutional neural networks in an encoder-decoder configuration. The best\nperforming models also connect the encoder and decoder through an attention\nmechanism. We propose a new simple network architecture, the Transformer, based\nsolely on attention mechanisms, dispensing with recurrence and convolutions\nentirely. Experiments on two machine translation tasks show these models to be\nsuperior in quality while being more parallelizable and requiring significantly\nless time to train. Our model achieves 28.4 BLEU on the WMT 2014\nEnglish-to-German translation task, improving over the existing best results,\nincluding ensembles by over 2 BLEU. On the WMT 2014 English-to-French\ntranslation task, our model establishes a new single-model state-of-the-art\nBLEU score of 41.8 after training for 3.5 days on eight GPUs, a small fraction\nof the training costs of the best models from the literature. We show that the\nTransformer generalizes well to other tasks by applying it successfully to\nEnglish constituency parsing both with large and limited training data.", "language": "en", "mimetype": "text/plain"}], "citations": [], "id": "b9342cad-eb65-4e8e-8397-47c77880ab76", "created": "2025-05-23T17:30:19.120Z", "updated": "2025-05-23T17:30:19.120Z", "extra": {"arxiv": {"base_id": "1706.03762", "comments": "15 pages, 5 figures", "categories": ["cs.CL", "cs.LG"]}}, "source": "legacy_import", "hidden_reason": null, "hidden_when": null, "title": "Attention Is All You Need", "original_title": null, "subtitle": null, "release_type": "article", "release_stage": "submitted", "release_date": "2017-12-06", "release_year": 2017, "volume": null, "issue": null, "pages": null, "number": null, "version": "v5", "publisher": null, "language": "en", "license_slug": "ARXIV-1.0", "withdrawn_status": null, "refs": null}}