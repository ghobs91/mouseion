# Credentials for the six providers that need them. The other 50 are keyless.
#
# SEC EDGAR refuses unidentified clients. Use a real contact address.
# SEC_USER_AGENT=mouseion/0.1 (Your Name you@example.com)

# Free key, no credit card: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# Free account token, no credit card: https://www.courtlistener.com/sign-in/
# COURTLISTENER_TOKEN=

# Free personal access token, no credit card: https://github.com/settings/tokens
# GITHUB_TOKEN=

# Free api.data.gov keys, no credit card: https://api.data.gov/signup/
# CONGRESS_API_KEY=
# GOVINFO_API_KEY=

# openFEC ships with the shared DEMO_KEY, which is rate-limited to the point of
# being unusable for more than a couple of calls. Register a free key and pass it
# as the `api_key` param: https://api.open.fec.gov/developers/
# (No environment variable is wired for openFEC; pass api_key in the call.)

# Runtime
# MOUSEION_PROVIDERS=./providers
# MOUSEION_DB=./.mouseion/cache.db
# MOUSEION_TTL=300
# MOUSEION_TIMEOUT=30
# MOUSEION_UA=mouseion/0.1 (you@example.com)
# MOUSEION_ALLOW_PRIVATE_URLS=0

# Failover engine
# MOUSEION_ENGINE_ATTEMPTS=3
# MOUSEION_ENGINE_ALLOW_AGGREGATORS=0
# MOUSEION_NEGATIVE_TTL=30
# MOUSEION_RATE_MAX_WAIT=2
# MOUSEION_CIRCUIT_THRESHOLD=3
# MOUSEION_CIRCUIT_COOLDOWN=60

# Router embeddings. Leave unset for lexical + pattern routing.
# MOUSEION_EMBED_URL=http://127.0.0.1:8081
# MOUSEION_EMBED_MODEL=bge-small-en-v1.5
# MOUSEION_EMBED_KEY=
# Or run a local ONNX model with `uv sync --extra embeddings`:
# MOUSEION_EMBED_BACKEND=fastembed
# MOUSEION_EMBED_MODEL=BAAI/bge-small-en-v1.5
#
# Router calibration is model-specific. Re-run `mouseion eval` after switching models.
# MOUSEION_ROUTER_ALPHA=0.8
# MOUSEION_COS_FLOOR=0.55
# MOUSEION_LEX_FLOOR=0.25
